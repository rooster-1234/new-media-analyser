# Plex Media Server Configuration
# Base URL for your Plex Media Server (e.g., http://localhost:32400 or http://192.168.1.50:32400)
PLEX_URL=http://localhost:32400

# Your Plex Token (X-Plex-Token)
# See: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=your_plex_token_here

# Optional: Specific library section names if you don't want to scan all
# Leave blank to automatically scan all Movie and TV sections
PLEX_MOVIE_LIBRARIES=
PLEX_TV_LIBRARIES=

# Jellyfin Media Server Configuration
JELLYFIN_URL=http://localhost:8096
JELLYFIN_KEY=

# Emby Media Server Configuration
EMBY_URL=http://localhost:8096
EMBY_KEY=

# Site scraper analyser for new releases
SITE_SCAN=https://thepiratebay.org/search.php?q=top100:48h_207

# Media Filtering Criteria
FILTER_EXCLUDE_EXISTING=true
FILTER_ONLY_CURRENT_YEAR=true
FILTER_REQUIRE_ENGLISH=true
FILTER_MIN_IMDB_SCORE=5.0

# Genre Preference Match Thresholds (Low, Medium, High)
GENRE_MATCH_HIGH_THRESHOLD=75
GENRE_MATCH_MEDIUM_THRESHOLD=40

# Disliked / Avoided Genres (comma-separated, automatically flags releases as 'Low' match)
# Available genres seen across your Plex library and IMDb:
#   Action, Adventure, Animation, Biography, Comedy, Crime, Documentary,
#   Drama, Family, Fantasy, Film-Noir, History, Horror, Music, Musical,
#   Mystery, Reality, Romance, Sci-Fi, Sport, Thriller, War, Western
FILTER_DISLIKED_GENRES=Fantasy, Romance

# Report Display Settings
MAX_SYNOPSIS_WORDS=60

# Optional: OMDb API Key (free at http://www.omdbapi.com/apikey.aspx)
# Used as an immediate fallback for brand-new releases when Cinemeta hasn't cached the score yet
OMDB_API_KEY=

# -----------------------------------------------------------------------------
# Media Downloader Integration (retrieve_media.py)
# -----------------------------------------------------------------------------
# Preferred downloader: radarr, seerr, sonarr, or rutorrent
DOWNLOAD_CLIENT=radarr

# Radarr Configuration (Movies)
# URL to your Radarr instance (e.g. http://localhost:7878 or http://NAS:7878)
RADARR_URL=http://localhost:7878
RADARR_API_KEY=
# Optional: Specific root folder path (e.g. /movies or D:\Movies). If empty, auto-detects first accessible folder
RADARR_ROOT_FOLDER=
# Optional: Specific quality profile name or ID (e.g. HD-1080p, Any). If empty, auto-detects default
RADARR_QUALITY_PROFILE=

# Seerr Configuration (Overseerr / Jellyseerr - coming soon)
SEERR_URL=http://localhost:5055
SEERR_API_KEY=

# Sonarr Configuration (TV Shows - coming soon)
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

# ruTorrent Configuration (Direct Torrent Client)
RUTORRENT_URL=http://localhost/rutorrent
RUTORRENT_USER=
RUTORRENT_PASSWORD=
# Auto-start downloads when added (true/false, default: true)
RUTORRENT_START_NOW=true
